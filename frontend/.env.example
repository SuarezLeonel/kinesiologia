# URL del Backend para la app móvil
# En desarrollo web local:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# En emulador Android local:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
#
# En dispositivo físico Android (misma red WiFi):
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:3000/api/v1
#
# En producción / Nube:
# EXPO_PUBLIC_API_URL=https://kinesiologia-backend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Proveedores OAuth 2.0 / OpenID Connect (Opcionales para inicio de sesión en frontend)
# Solo los Client IDs / App IDs públicos van en el frontend. NUNCA los secrets ni claves privadas.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
