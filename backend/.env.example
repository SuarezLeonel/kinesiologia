# Configuración del Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,exp://192.168.1.1:8081

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=
DB_NAME=kinesiologia_db
DB_CONNECTION_LIMIT=10
# true para TiDB Cloud / MySQL gestionado con TLS; false para MySQL local
DB_SSL=false

# Seguridad JWT (OBLIGATORIO: mínimo 32 caracteres, distintos entre sí; el servidor no arranca sin ellos)
# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Proveedores OAuth 2.0 / OpenID Connect (Opcionales - para activar inicio de sesión real)
# Ver guía detallada paso a paso en docs/OAUTH_SETUP.md
# Google Cloud Console (OAuth Client ID tipo Web y Móvil)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 (Configuración en https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Meta for Developers (Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Configuración de Envío de Correo Electrónico (Recuperación de contraseña)
# =========================================================================
# Opción 1 (RECOMENDADA para Render / Producción sin dominio propio):
# Google Apps Script Web App (HTTPS, puerto 443).
# Envía desde tu cuenta personal de Gmail (@gmail.com) mediante MailApp.sendEmail().
# No requiere dominio web, no requiere configurar registros DNS (SPF/DKIM/MX), y elude
# los bloqueos de puertos SMTP (25, 465, 587) de Render.
# Ver guía paso a paso en docs/GOOGLE_APPS_SCRIPT.md
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_SECRET=un_secreto_aleatorio_seguro_minimo_32_caracteres
APPS_SCRIPT_TIMEOUT_MS=10000

# Opción 2: API HTTP de Resend / Brevo (HTTPS, puerto 443) — Preparado para migración futura
# Requieren dominio propio verificado en su DNS para enviar a cualquier destinatario.
# Obtener API Key en https://resend.com (3.000 emails/mes) o https://brevo.com
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=

# SOLO desarrollo local: devuelve el código de recuperación en la respuesta JSON (nunca en producción)
EXPOSE_RESET_CODE=false

# Nombre de remitente general y URL de la aplicación
EMAIL_FROM="KinesioGestión" <no-reply@kinesiologia.com>
APP_URL=http://localhost:8081

