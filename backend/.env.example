# Configuración del Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,exp://192.168.1.1:8081

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=kinesiologia_db
DB_CONNECTION_LIMIT=10
DB_SSL=true

# Seguridad JWT
JWT_ACCESS_SECRET=cambiar_por_un_secreto_largo_y_seguro_para_access_tokens_kinesiologia_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_por_un_secreto_largo_y_seguro_para_refresh_tokens_kinesiologia_2026
JWT_REFRESH_EXPIRES_IN=7d

# Proveedores OAuth (Opcional - solo si se configuran credenciales reales)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
APPLE_CLIENT_ID=
