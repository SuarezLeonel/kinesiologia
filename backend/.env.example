# Configuración del Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,exp://192.168.1.1:8081

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=
DB_NAME=kinesiologia_db
DB_CONNECTION_LIMIT=10
# true para TiDB Cloud / MySQL gestionado con TLS; false para MySQL local
DB_SSL=false

# Seguridad JWT (OBLIGATORIO: mínimo 32 caracteres, distintos entre sí; el servidor no arranca sin ellos)
# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Proveedores OAuth 2.0 / OpenID Connect (Opcionales - para activar inicio de sesión real)
# Ver guía detallada paso a paso en docs/OAUTH_SETUP.md
# Google Cloud Console (OAuth Client ID tipo Web y Móvil)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 (Configuración en https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Meta for Developers (Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Configuración de Envío de Correo Electrónico (Recuperación de contraseña)
# Opción A (Recomendada en Render Free tier): API HTTP sobre HTTPS (Puerto 443 - no es bloqueado por Render)
# Obtener API Key gratuita en https://resend.com (3.000 emails/mes gratis) o Brevo
RESEND_API_KEY=
BREVO_API_KEY=

# Opción B: SMTP Tradicional (Gmail, Outlook, etc. - Funciona en desarrollo o servidores que permiten puertos 587/465)
# Nota: Render Free tier bloquea los puertos 25, 465 y 587 por defecto.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KinesioGestión" <no-reply@kinesiologia.com>
APP_URL=http://localhost:8081

